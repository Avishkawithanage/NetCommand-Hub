# NetCommand Hub - optional settings. Copy to your environment if you need to change a default.
# No secrets are required. Never put real credentials in this file.

# Folder with catalog.yaml, glossary.yaml and vendors/ (default: <project>/data)
NCH_DATA_DIR=

# Built web app served by the backend (default: <project>/frontend/dist)
NCH_FRONTEND_DIST=

# Browser origins allowed to call the API (comma separated)
NCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest accepted request body in bytes
NCH_MAX_BODY_BYTES=1000000
